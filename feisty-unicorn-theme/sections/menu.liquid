<section id="menu" class="menu" data-section-id="menu" data-section-type="menu">
  <div class="container">
    <h2 class="section-title">{{ section.settings.heading }}</h2>
    {% if section.settings.copy != blank %}
      <p class="menu__intro">{{ section.settings.copy }}</p>
    {% endif %}
    <div class="menu__grid">
      {% for block in section.blocks %}
        <article class="menu__item" {{ block.shopify_attributes }}>
          <header class="menu__header">
            <h3>{{ block.settings.title }}</h3>
            {% if block.settings.badge != blank %}
              <span class="menu__badge">{{ block.settings.badge }}</span>
            {% endif %}
          </header>
          <p>{{ block.settings.description }}</p>
          {% if block.settings.price != blank %}
            <span class="menu__price">{{ block.settings.price }}</span>
          {% endif %}
        </article>
      {% else %}
        <p>No menu items yet. Add some in the theme editor!</p>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Menu",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "FUCH Favorites"},
    {"type": "textarea", "id": "copy", "label": "Intro copy", "default": "We rotate through drops inspired by our Feisty Unicorn mascot—upload the artwork we created for each drink to keep the visuals consistent."}
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Menu item",
      "settings": [
        {"type": "text", "id": "title", "label": "Title", "default": "Wake the FUCH Up!"},
        {"type": "text", "id": "badge", "label": "Badge", "default": "Dark Roast"},
        {"type": "textarea", "id": "description", "label": "Description", "default": "Our signature dark roast—smoky fudge, cola pop, and a punchy caffeine kick."},
        {"type": "text", "id": "price", "label": "Price", "default": "$18 / 12oz"}
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Menu",
      "category": "Food & drink",
      "blocks": [
        {"type": "item"},
        {"type": "item"},
        {"type": "item"},
        {"type": "item"}
      ]
    }
  ]
}
{% endschema %}
