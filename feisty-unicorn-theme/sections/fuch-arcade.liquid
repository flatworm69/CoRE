<section id="fuch-arcade" class="arcade" data-section-id="fuch-arcade" data-section-type="fuch-arcade">
  <div class="container">
    <div class="arcade__intro">
      <p class="arcade__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      <p class="arcade__copy">{{ section.settings.copy }}</p>
      <div class="arcade__hud">
        <div class="arcade__score" data-arcade-score>Score: 0</div>
        <button class="button button--ghost" type="button" data-arcade-start>{{ section.settings.button_label }}</button>
      </div>
    </div>
    <div class="arcade__canvas-wrap">
      <canvas width="520" height="260" data-arcade-canvas aria-label="Feisty Unicorn arcade runner"></canvas>
      <p class="arcade__tip">{{ section.settings.tip }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FUCH arcade mini-game",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Play with your latte"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Run, Unicorn, Run!"},
    {"type": "textarea", "id": "copy", "label": "Intro copy", "default": "Tap or press space to help our feisty mascot dodge decaf goblins and snag limited-release beans."},
    {"type": "text", "id": "button_label", "label": "Start button label", "default": "Start Game"},
    {"type": "text", "id": "tip", "label": "Control tip", "default": "Controls: Space / tap to jump. Collect beans, avoid goblins."}
  ],
  "presets": [
    {"name": "FUCH arcade mini-game"}
  ]
}
{% endschema %}
