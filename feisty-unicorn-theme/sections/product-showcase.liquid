<section id="roasts" class="showcase" data-section-id="product-showcase" data-section-type="product-showcase">
  <div class="container">
    <div class="showcase__intro">
      <p class="showcase__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      <p class="showcase__copy">{{ section.settings.copy }}</p>
    </div>
    <div class="showcase__grid">
      {% for block in section.blocks %}
        <article class="showcase__item" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="showcase__media">
              <img
                src="{{ block.settings.image | img_url: '600x' }}"
                srcset="{{ block.settings.image | img_url: '400x' }} 400w, {{ block.settings.image | img_url: '600x' }} 600w, {{ block.settings.image | img_url: '800x' }} 800w"
                sizes="(min-width: 900px) 240px, 100vw"
                alt="{{ block.settings.image_alt | escape }}"
                loading="lazy"
              >
            </div>
          {% endif %}
          <div class="showcase__content">
            {% if block.settings.tag != blank %}
              <p class="showcase__tag">{{ block.settings.tag }}</p>
            {% endif %}
            <h3>{{ block.settings.title }}</h3>
            <p class="showcase__notes">{{ block.settings.notes }}</p>
            <ul class="showcase__meta">
              {% if block.settings.roast != blank %}
                <li><strong>Roast:</strong> {{ block.settings.roast }}</li>
              {% endif %}
              {% if block.settings.origin != blank %}
                <li><strong>Origin:</strong> {{ block.settings.origin }}</li>
              {% endif %}
              {% if block.settings.tasting != blank %}
                <li><strong>Tasting:</strong> {{ block.settings.tasting }}</li>
              {% endif %}
            </ul>
            {% if block.settings.cta_label != blank and block.settings.cta_link != blank %}
              <a class="button button--ghost" href="{{ block.settings.cta_link }}">{{ block.settings.cta_label }}</a>
            {% endif %}
          </div>
        </article>
      {% else %}
        <p class="showcase__empty">Add product highlight blocks to feature roasts, seasonal drinks, or merch capsules.</p>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
